<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/updateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="发现新版本"
        android:textColor="#0E1116"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="4dp"
        android:text="更新后体验最新功能，覆盖安装不会丢失数据。"
        android:textColor="#5B6472"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/updateProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="18dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <TextView
        android:id="@+id/updateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#98A1AD"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateLater"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="稍后"
            android:textColor="#5B6472"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/updateNow"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_dialog_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="112dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="立即更新"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
